# Copy to .env and fill in keys, then run with: uv run --env-file .env uvicorn ...
# Aliyun Qwen (DashScope OpenAI-compatible endpoint):
OPENAI_API_KEY=sk-xxxx
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Default model used by new conversations (must match an id in config.py)
GEOAGENT_DEFAULT_MODEL=qwen3.7-max-2026-06-08

# Optional: pin a cheaper model for the router agent
GEOAGENT_ROUTER_MODEL=

# Where conversations are persisted (defaults to backend/data)
GEOAGENT_DATA_DIR=

# 土地变化检测库（PostgreSQL/PostGIS，只读账号；连接局域网内服务）
GEOAGENT_PG_DSN=postgresql://user:pass@192.168.3.209:5432/land_change

# 只读白名单（逗号分隔）：图斑主表 + 图斑类型字典 + 合并地类字典视图
GEOAGENT_PG_WHITELIST=data."2026_1_change_landuse",knowledge_base.dict_tblx,knowledge_base.dict_land_classification_summary

# 单次查询最大返回行数与查询超时（秒）
GEOAGENT_PG_MAX_ROWS=200
GEOAGENT_PG_TIMEOUT_S=10

# 快报等生成文件的输出目录（默认 %LOCALAPPDATA%/GeoAgent/reports，仓库外）
GEOAGENT_REPORTS_DIR=

# Skills directory (defaults to <project root>/skills)
GEOAGENT_SKILLS_DIR=
